### Register User
POST http://localhost:8080/auth/register
Content-Type: application/json

{
  "email": "user@student.curtin.edu.au",
  "password": "userpassword"
}

### Register Admin (if you have an admin registration endpoint)
POST http://localhost:8080/auth/register
Content-Type: application/json

{
  "email": "admin@student.curtin.edu.au",
  "password": "adminpassword"
}

### Login as User
POST http://localhost:8080/auth/login
Content-Type: application/json

{
  "email": "user@student.curtin.edu.au",
  "password": "userpassword"
}
> {%
    client.test("Save token to global variables", function() {
        // 1. Ensure we have an object, parsing it manually if IntelliJ kept it as a string
        let body = response.body;
        if (typeof body === "string") {
            body = JSON.parse(body);
        }

        // 2. Assert that the token actually exists
        client.assert(body.token !== undefined, "Failed to find 'token' in response");

        // 3. Save it and log it
        client.global.set("user_token", body.token);
        client.log("SUCCESS! Saved User Token: " + body.token);
    });
%}

### Login as Admin
POST http://localhost:8080/auth/login
Content-Type: application/json

{
  "email": "admin@student.curtin.edu.au",
  "password": "adminpassword"
}

> {%
    const data = JSON.parse(response.body);
    client.global.set("admin_token", data.token);
%}


### Get Units (Public - no auth needed)
GET http://localhost:8080/units


### Get Unit (COMP2003) (Public - no auth needed)
GET http://localhost:8080/units/COMP2002


### Create Unit (Admin only)
POST http://localhost:8080/units
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "code": "COMP3004",
  "name": "Software Engineering 2",
  "description": "Learn about software engineering practices v2"
}

### Create Review (User role required)
POST http://localhost:8080/reviews
Authorization: Bearer {{user_token}}
Content-Type: application/json

{
  "rating": 8,
  "finalGrade": 85,
  "reviewText": "WERE BACK AGAIN",
  "semesterTaken": "2024-2",
  "professor": "Dr. Arlen",
  "workload": 5,
  "hasExam": true,
  "wouldTakeAgain": true,
  "unit": {
    "code": "COMP2002"
  }
}


### Delete Unit (Admin only)
DELETE http://localhost:8080/units/1
Authorization: Bearer {{admin_token}}

### Delete Review (Owner or Admin)
DELETE http://localhost:8080/reviews/1
Authorization: Bearer {{user_token}}

