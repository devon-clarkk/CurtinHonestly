### Login as Admin
POST http://localhost:8080/auth/login
Content-Type: application/json

{
  "email": "admin@student.curtin.edu.au",
  "password": "adminpassword"
}

> {%
    const data = JSON.parse(response.body);
    client.global.set("admin_token", data.token);
%}

